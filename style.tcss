Screen { background: #0b101a; color: #d9e2f2; }
Header { background: #121b2b; color: #79e2c2; text-style: bold; }
Footer { background: #121b2b; }
#body { height: 1fr; }
#sidebar { width: 25; background: #101827; padding: 1 1; border-right: solid #25334b; }
.eyebrow { color: #91a3bf; text-style: bold; height: auto; margin: 1 0; }
.node { width: 100%; height: 4; margin-bottom: 1; background: #151f30; border: round #283852; color: #a6b7d0; content-align: left middle; }
.node:hover { background: #21334a; }
.node.selected { background: #1d3b3c; border: round #79e2c2; color: #b6f4e4; }
#network-label { color: #79e2c2; height: auto; margin: 2 1 1 1; }
.muted { color: #91a3bf; margin: 1; height: auto; }
#main { padding: 0 1; }
#node-heading { height: 3; content-align: left middle; text-style: bold; color: #c7b4f8; padding-left: 1; }
TabbedContent { height: 1fr; }
TabPane { padding: 0 1; }
VerticalScroll { height: 1fr; }
#metrics { height: 6; margin-top: 1; }
.metric { width: 1fr; height: 6; padding: 0 1; margin-right: 1; border: round #2a3c55; background: #111c2c; }
#history { height: 3; color: #79e2c2; margin-bottom: 1; }
#details { height: auto; min-height: 2; color: #a6b7d0; }
#sharing-box { height: auto; }
#sharing { height: auto; color: #a6b7d0; }
#upload-history { height: 3; color: #79e2c2; margin-bottom: 1; }
.actions { height: auto; min-height: 3; margin: 1 0; }
.actions Button { margin-right: 1; min-width: 12; width: auto; }
Button { border: round #334665; background: #17253a; color: #d9e2f2; }
Button.-primary { background: #246157; color: #e2fff6; border: round #79e2c2; }
Button:hover { background: #2b405f; }
Button:disabled { color: #596a85; background: #121b2b; border: round #1e2d43; }
DataTable { background: #101827; height: 9; margin-top: 1; }
DataTable > .datatable--header { background: #1a2940; color: #a6b7d0; }
DataTable > .datatable--cursor { background: #255349; color: #dcfff1; }
#fleet { height: auto; max-height: 8; }
#workspaces { height: 7; }
#windows { min-height: 7; height: 10; }
#workspace { width: 23; margin-right: 1; }
#hypr-summary { height: auto; min-height: 3; padding-top: 1; color: #a6b7d0; }
#activity { height: 6; min-height: 4; border: round #25334b; margin-top: 1; background: #0d1521; color: #91a3bf; padding: 0 1; }
#report { height: 17; min-height: 8; border: round #2a3c55; background: #101827; padding: 0 1; }
Input { background: #121e30; border: round #334665; margin: 0 0 1 0; }
Label { color: #a6b7d0; margin-top: 1; }
.explanation { height: auto; color: #a6b7d0; margin: 1 0; }
#transfer-status { height: auto; margin-top: 1; color: #79e2c2; }
Confirm { align: center middle; background: #000000 65%; }
#confirm-dialog { width: 64; height: auto; max-height: 90%; border: round #79e2c2; background: #152237; padding: 1 2; }
#confirm-dialog Static { height: auto; }
#confirm-dialog .actions { align-horizontal: right; }
.clipboard-help { height: auto; width: 1fr; padding: 0 1; color: #a6b7d0; }
#clipboard-result { height: auto; min-height: 2; color: #79e2c2; }
.clipboard-card { height: auto; padding: 1; margin: 0 0 1 0; border: round #2a3c55; background: #101827; }
.clipboard-title { height: 1; text-style: bold; color: #c7b4f8; margin-bottom: 1; }
.clipboard-text { height: 7; border: round #334665; background: #0d1521; }
.clipboard-state { height: auto; min-height: 1; color: #a6b7d0; margin-top: 1; }
.clipboard-card .actions { overflow-x: auto; }
#process-pane { height: 1fr; }
#process-summary { height: 4; margin-top: 1; }
.proc-metric { width: 1fr; height: 4; padding: 0 1; margin-right: 1; border: round #2a3c55; border-title-color: #91a3bf; border-title-style: bold; background: #111c2c; text-wrap: nowrap; text-overflow: ellipsis; }
#process-controls { height: 3; margin-top: 1; }
#proc-filter { width: 1fr; margin: 0 1 0 0; }
#proc-mine { width: auto; height: 3; margin-right: 1; background: #121e30; border: round #334665; }
#proc-mine:focus { border: round #79e2c2; }
#proc-end { width: auto; min-width: 16; }
#proc-status { height: 1; color: #91a3bf; margin-top: 1; text-wrap: nowrap; text-overflow: ellipsis; }
#proc-table { height: 1fr; min-height: 6; margin-top: 0; }
#proc-detail { height: 3; color: #a6b7d0; margin-top: 1; text-wrap: nowrap; text-overflow: ellipsis; }
#proc-note { height: auto; max-height: 2; color: #91a3bf; }
#heading-row { height: 3; }
#heading-row #node-heading { width: 1fr; text-wrap: nowrap; text-overflow: ellipsis; }
#wake-state { width: auto; height: 3; content-align: right middle; padding: 0 1; }
#wake { width: auto; min-width: 12; display: none; }
#speed-result { height: auto; min-height: 1; margin-bottom: 1; }
.group-label { width: 11; height: 3; content-align: left middle; color: #91a3bf; text-style: bold; }
.group-help { width: 1fr; height: 3; content-align: left middle; color: #596a85; }
Prompt { align: center middle; background: #000000 65%; }
#prompt-dialog { width: 72; height: auto; max-height: 90%; border: round #79e2c2; background: #152237; padding: 1 2; }
#prompt-dialog .dialog-title { height: auto; text-style: bold; color: #c7b4f8; margin-bottom: 1; }
#prompt-dialog .actions { align-horizontal: right; margin-bottom: 0; }
#run-pane { height: 1fr; }
#run-controls { height: 3; }
#run-command { width: 1fr; margin: 0 1 0 0; }
#run-go { width: auto; min-width: 14; }
#run-targets { height: 3; margin-top: 1; }
#run-targets Checkbox { width: auto; height: 3; margin-right: 1; background: #121e30; border: round #334665; }
#run-targets Checkbox:focus { border: round #79e2c2; }
#run-status { height: 1; margin: 1 0 0 0; color: #91a3bf; text-wrap: nowrap; text-overflow: ellipsis; }
#run-output { height: 1fr; min-height: 6; margin-top: 1; border: round #2a3c55; background: #101827; padding: 0 1; }
